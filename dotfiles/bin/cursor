#!/bin/bash
# Installed as ~/bin/cursor (with ~/bin/cursor-agent and ~/bin/agent -> cursor) by the
# cursor-agent-setup skill (claude-skills repo). Edit cursor-agent-setup/scripts/cursor there, not in ~/bin.
#
# cursor-agent intermittently rejects a valid model id at startup ("Cannot use this
# model", exit 1 within seconds). Any run that exits non-zero inside 10 s is retried up
# to 4 times; stderr is held in a file and replayed after the last attempt.
# When stdout is not a terminal (-p runs, reviews), a run that writes nothing to stdout
# is a failure too: retried like the above if it took under 10 s, and the wrapper exits 1
# with a message on stderr instead of 0, so callers do not log an empty result as success.
# Aliases: ntm's --cursor flag forbids [ ] , = so grok-4.7-xhigh-500k expands here.
# node dies with "JavaScript heap out of memory" under a low virtual-memory ulimit; raise
# the soft limit to 256G, or to the hard limit where that is lower.
ulimit -Sv $((256*1024*1024)) 2>/dev/null || ulimit -Sv "$(ulimit -Hv)" 2>/dev/null || true
# The CLI rewrites cli-config.json on updates; re-enforce our key fields (fail-soft).
if [[ -f $HOME/.cursor/cli-config.json ]]; then
  python3 - "$HOME/.cursor/cli-config.json" 2>/dev/null <<'EOF' || true
import json, sys
p = sys.argv[1]
try:
    with open(p) as f: cfg = json.load(f)
except Exception: sys.exit(0)
changed = False
att = cfg.setdefault("attribution", {})
for k in ("attributeCommitsToAgent", "attributePRsToAgent"):
    if att.get(k) is not False: att[k] = False; changed = True
if cfg.get("approvalMode") != "unrestricted":
    cfg["approvalMode"] = "unrestricted"; changed = True
want_status = {"type": "command", "command": "~/.cursor/statusline.sh", "padding": 2}
if cfg.get("statusLine") != want_status:
    cfg["statusLine"] = want_status; changed = True
if changed:
    with open(p, "w") as f: json.dump(cfg, f, indent=2); f.write("\n")
EOF
fi
AGENT=${CURSOR_AGENT_REAL:-$HOME/.local/bin/cursor-agent}
if [[ ! -x $AGENT || $(readlink -f "$AGENT") == $(readlink -f "$0") ]]; then
  echo "cursor: no real cursor-agent at $AGENT; install the Cursor CLI" \
       "(curl https://cursor.com/install -fsS | bash) or set CURSOR_AGENT_REAL" >&2
  exit 127
fi
args=()
for a in "$@"; do
  case "$a" in
    grok-4.7-xhigh-500k)         a="grok-4.7[context=500k,reasoning_effort=xhigh,fast=false]" ;;
    --model=grok-4.7-xhigh-500k) a="--model=grok-4.7[context=500k,reasoning_effort=xhigh,fast=false]" ;;
  esac
  args+=("$a")
done
[[ $# -eq 0 ]] && args=(--model "grok-4.7[context=500k,reasoning_effort=high,fast=false]")
errf=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/cursor-stderr.XXXXXX"); trap 'rm -f "$errf"' EXIT
# Pass stdout through unchanged; exit 9 if the stream ended before its first byte.
first_byte() {
  IFS= read -r -n1 -d '' c || exit 9
  if [[ -n $c ]]; then printf '%s' "$c"; else printf '\0'; fi
  cat; exit 0
}
for attempt in 1 2 3 4; do
  t0=$SECONDS; empty=0
  if [[ -t 1 ]]; then
    "$AGENT" "${args[@]}" 2>"$errf"; rc=$?
  else
    "$AGENT" "${args[@]}" 2>"$errf" | first_byte
    st=("${PIPESTATUS[@]}"); rc=${st[0]}; (( st[1] == 9 )) && empty=1
  fi
  (( (rc != 0 || empty) && SECONDS - t0 < 10 && attempt < 4 )) && { sleep 2; continue; }
  cat "$errf" >&2
  if (( empty && rc == 0 )); then
    echo "cursor: cursor-agent exited 0 but wrote nothing to stdout (attempt $attempt, $((SECONDS - t0)) s); exiting 1" >&2
    exit 1
  fi
  exit $rc
done
